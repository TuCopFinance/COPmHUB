# Canonical URL for sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=https://digitalcop.shop

# --- Bre-B off-ramp pre-registration (optional) ---------------------------
# This site only hosts the form. The browser talks straight to TuCOPRamp,
# which is where every record is kept; nothing is stored here and there are
# no secrets below.
#
# The card, the pop-up and /offramp stay off unless OFFRAMP_ENABLED is "true"
# AND the three variables under it are set. The home and privacy pages are
# static, so the flag is read at build time: changing it needs a redeploy.
OFFRAMP_ENABLED=false

# Base URL of the TuCOPRamp API (https). This origin must be allowed in
# TuCOPRamp's CORS_ORIGINS.
OFFRAMP_API_URL=https://api.ramp.tucop.xyz
# Legal name of the data controller, shown in the consent text.
OFFRAMP_DATA_CONTROLLER=
# Contact email for privacy requests and support.
OFFRAMP_PRIVACY_CONTACT=
