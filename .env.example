# Canonical URL for sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=https://digitalcop.shop

# Google Analytics measurement ID (G-XXXXXXXXXX). Leave empty to keep
# analytics off: events are still pushed to dataLayer but sent nowhere.
NEXT_PUBLIC_GA_ID=

# --- Bre-B off-ramp and on-ramp (optional) ---------------------------------
# People register here as direct clients of TuCOP Ramp. The browser calls only
# this site (/api/ramp); the server relays a fixed list of calls to the
# TuCOPRamp platform API with TuCOP Ramp's integrator key. Nothing the person
# types is stored or logged here.
#
# The card, the pop-up and /offramp stay off unless OFFRAMP_ENABLED is "true"
# AND every variable under it is set. The home and privacy pages are static,
# so the flag is read at build time: changing it needs a redeploy.
OFFRAMP_ENABLED=false

# Base URL of the TuCOPRamp API (https). Server only.
TUCOPRAMP_API_URL=https://api.ramp.tucop.xyz
# TuCOP Ramp's integrator key (tcr_live_sk_...). SECRET, server only: never
# commit it, never put it in a NEXT_PUBLIC_ variable. TuCOP issues it in the
# integrator console and sets it in Railway.
TUCOPRAMP_API_KEY=
# Legal name of the data controller, shown in the consent text.
OFFRAMP_DATA_CONTROLLER=
# Contact email for privacy requests and support.
OFFRAMP_PRIVACY_CONTACT=

# Buying USDC with pesos (/v1/deposits). Bridge production has COP virtual
# accounts; the Bridge sandbox does not (422 provider_rejected). Needs
# OFFRAMP_ENABLED too. The privacy and terms pages read it at build time.
ONRAMP_ENABLED=false

# Signing secret (whsec_...) of this site's webhook endpoint under the TuCOP
# Ramp integrator, for https://digitalcop.shop/api/webhooks/tucopramp. SECRET,
# server only: TuCOP creates the endpoint and sets it in Railway. Without it
# the endpoint answers 503.
TUCOPRAMP_WEBHOOK_SECRET=
